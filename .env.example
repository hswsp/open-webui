# Open WebUI 配置
WEBUI_SECRET_KEY=your-secret-key-here

# 管理员账户（自动配置脚本使用）
OWUI_ADMIN_EMAIL=admin@example.com
OWUI_ADMIN_PASSWORD=your-admin-password

# 火山方舟 Agent Plan API Key（以 ark- 开头）
OWUI_ARK_API_KEY=ark-your-api-key

# 火山引擎模型列表（逗号分隔，自动配置所有模型）
# 不设置则使用以下默认值
OWUI_ARK_CHAT_MODELS=doubao-seed-2.0-code,doubao-seed-2.0-pro,doubao-seed-2.0-lite,doubao-seed-2.0-mini,minimax-m2.7,glm-5.1,kimi-k2.6,deepseek-v4-pro,deepseek-v4-flash
OWUI_ARK_VISION_MODELS=doubao-seedream-5.0-lite
OWUI_ARK_IMAGE_MODEL=doubao-seedream-5.0-lite
OWUI_ARK_EMBEDDING_MODEL=doubao-embedding-vision

# 火山引擎 RAG Embedding 模型（可选）
RAG_EMBEDDING_ENGINE=openai
RAG_EMBEDDING_MODEL=doubao-embedding-vision

# Host 端口映射（默认为 8081）
HOST_PORT=8081

# Open WebUI 数据目录（默认 ~/open-webui/data）
OWUI_DATA_DIR=~/open-webui/data

# Open WebUI 访问地址（默认为 http://localhost:8081）
OWUI_API_BASE=http://localhost:8081
